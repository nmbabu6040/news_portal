{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_KEY": "base64:QVZQb3J0YWxQYXJhZ2F3YXlQYXJhZ2F3YXk==",
        "APP_DEBUG": "false",
        "APP_URL": "https://news-portal.vercel.app",
        "DB_CONNECTION": "mysql",
        "DB_HOST": "localhost",
        "LOG_CHANNEL": "stderr",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie"
    }
}
